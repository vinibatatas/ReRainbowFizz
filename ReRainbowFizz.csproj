<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <AssemblyName>ReRainbowFizz</AssemblyName>
    <RootNamespace>RedragonFizzMacro</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>RedragonFizzMacro.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Installer\**" />
    <None Include="Installer\**" />
    <Compile Remove="Uninstaller\**" />
    <None Include="Uninstaller\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\app_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\app_icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
