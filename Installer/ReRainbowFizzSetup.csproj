<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\Resources\app_icon.ico</ApplicationIcon>
    <AssemblyName>Instalador_ReRainbowFizz</AssemblyName>
    <RootNamespace>RedragonFizzMacro.Installer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" />
    <Content Include="..\Resources\app_icon.ico">
      <Link>app_icon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
